# Runtime data path inside the container
DATABASE_PATH=/data/checker.sqlite3

# Legacy Telegram credentials, imported once explicitly from Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# External Fernet key shared by API, worker and dispatcher; never store it in SQLite.
# Generate with cryptography.fernet.Fernet.generate_key(); back up separately.
NOTIFICATION_SECRET_KEY=

# Exact operator-controlled HTTPS and SMTP exceptions. No networks or wildcards.
# Example: [{"host":"ntfy.example","port":443,"addresses":["10.0.0.2"]}]
WEBHOOK_PRIVATE_ALLOWLIST=[]

DEFAULT_TIMEZONE=Europe/Berlin
# Availability transport settings. The browser profile is emulated by curl_cffi; no browser runs.
DOCTOLIB_PROFILE=safari2601
DOCTOLIB_PAGE_DAYS=15
# USER_AGENT applies to metadata requests only; it does not override the availability profile.
USER_AGENT=DoctolibChecker/2.0
MINIMUM_POLL_INTERVAL_SECONDS=300
REQUEST_SPACING_SECONDS=3
# Checking deadlines include gate waits, retries and network time. Slice must be >= target.
TARGET_BUDGET_SECONDS=120
SLICE_BUDGET_SECONDS=180
# Tune from Activity queue lag and budget errors for large date windows/congested egress.
# These limits do not guarantee latency under unlimited load; keep provider spacing intact.
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
WORKER_TICK_SECONDS=2
